@model List<UsuarioModel>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listagem de Usuários</h2>
        <a asp-controller="Usuario" asp-action="Cadastrar" class="btn btn-success">Cadastrar novo usuário</a>
    </div>
    <table class="table table-hover table-bordered" id="registros">
        <thead class="table-dark">
            <tr>
                <th>Cargo</th>
                <th>Nome</th>
                <th>Estado</th>
                <th>Email</th>
                <th>Data de Criação</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @if(Model != null && Model.Count > 0)
            {
                foreach(var usuario in Model)
                {
                    <tr>
                        <td>@usuario.Cargo</td>
                        <td>@usuario.Nome</td>
                        <td>@(usuario.Endereco?.Estado ?? "N/A")</td>
                        <td>@usuario.Email</td>
                        <td>@usuario.DataCadastro.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-controller="Usuario" asp-action="Editar" asp-route-id="@usuario.Id" class="btn btn-info"><i class="bi bi-pencil"></i>Editar</a>
                           
                        </td>
                    </tr>
                }
            }

        </tbody>


    </table>
</div>